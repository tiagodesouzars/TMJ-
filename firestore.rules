rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // Schema state & migration metadata
    match /tmj_meta/{docId} {
      allow read, write: if true;
    }

    // Direct root collections under new terms (midiaUrl + Cloud Storage)
    match /tmj_members/{document=**} {
      allow read, write: if true;
    }
    match /tmj_vault/{document=**} {
      allow read, write: if true;
    }
    match /tmj_chat/{document=**} {
      allow read, write: if true;
    }
    match /tmj_vault_chunks/{document=**} {
      allow read, write: if true;
    }

    // Artifacts data collections (for sync and legacy cleanup)
    match /artifacts/{appId}/public/data/{col}/{document=**} {
      allow read, write: if true;
    }
  }
}
