rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Artifacts data collections (used by TMJ app)
    match /artifacts/{appId}/public/data/{col}/{document=**} {
      allow read, write: if true;
    }

    // Direct root collections
    match /tmj_members/{document=**} {
      allow read, write: if true;
    }
    match /tmj_vault/{document=**} {
      allow read, write: if true;
    }
    match /tmj_chat/{document=**} {
      allow read, write: if true;
    }
  }
}
