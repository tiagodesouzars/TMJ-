            const progEl = document.getElementById(`prog_${audioId}`);
            const timeEl = document.getElementById(`time_${audioId}`);

            if (audioEl.paused) {
                audioEl.play();
                btnEl.innerHTML = `<i class="fa-solid fa-pause"></i>`;
                const updateProg = () => {
                    if (!audioEl.paused) {
                        const pct = (audioEl.currentTime / audioEl.duration) * 100;
                        if (progEl) progEl.style.width = `${pct}%`;
                        const curMin = String(Math.floor(audioEl.currentTime / 60)).padStart(2, '0');
                        const curSec = String(Math.floor(audioEl.currentTime % 60)).padStart(2, '0');
                        if (timeEl) timeEl.textContent = `${curMin}:${curSec}`;
                        requestAnimationFrame(updateProg);
                    }
                };
                updateProg();
                audioEl.onended = () => {
                    btnEl.innerHTML = `<i class="fa-solid fa-play"></i>`;
                    if (progEl) progEl.style.width = '0%';
                    if (timeEl) timeEl.textContent = `00:${String(duration || 0).padStart(2, '0')}`;
                };
            } else {
                audioEl.pause();
                btnEl.innerHTML = `<i class="fa-solid fa-play"></i>`;
