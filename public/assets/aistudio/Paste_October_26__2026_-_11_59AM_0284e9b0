                    <div class="flex items-center gap-2">
                        <span class="font-mono text-[10px] uppercase font-bold" style="color:${m.authorColor}">${m.authorName}</span>
                        <span class="font-mono text-[9px] text-stencil">${new Date(m.timestamp).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</span>
                    </div>
                    <div class="bg-concrete border border-neutral-800 rounded-sm p-3 max-w-[85%] shadow-md">
                        ${contentHtml}
                    </div>
                `;
                list.appendChild(bubble);
            });
            list.scrollTop = list.scrollHeight;
        }

        // ==================== MODAL SQUAD ID ====================
        window.openSquadModal = () => {
            document.getElementById('modal-squad').classList.remove('hidden');
            const form = document.getElementById('squad-edit-form');
            form.innerHTML = '';

            window.squadMembers.forEach(m => {
                const isCurrent = m.id === window.activeMember.id;
                const div = document.createElement('div');
                div.className = `bg-asphalt border ${isCurrent ? 'border-acid' : 'border-neutral-800'} p-3 rounded-sm space-y-2`;
                div.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="font-display text-lg" style="color:${m.color}">${m.name} ${isCurrent ? '(Você)' : ''}</span>
                        <span class="font-mono text-[9px] text-stencil uppercase">${m.handle}</span>
                    </div>
                    ${isCurrent ? `
                        <label class="block font-mono text-[9px] text-acid uppercase tracking-widest">Sua Tag Personalizada:</label>
                        <input type="text" id="edit_role_${m.id}" value="${m.role || ''}" class="w-full bg-concrete border border-neutral-700 rounded-sm px-2 py-1.5 text-xs text-white font-mono focus:border-acid focus:outline-none">
                        
                        <label class="block font-mono text-[9px] text-acid uppercase tracking-widest mt-2">Avatar ou GIF URL:</label>
                        <input type="text" id="edit_avatar_${m.id}" value="${m.customAvatar || ''}" placeholder="Cole URL de imagem ou GIF" class="w-full bg-concrete border border-neutral-700 rounded-sm px-2 py-1.5 text-xs text-white font-mono focus:border-acid focus:outline-none">
                    ` : `
                        <p class="font-mono text-[10px] text-chalk">Tag: ${m.role || 'Membro do Trio'}</p>
                    `}
                `;
                form.appendChild(div);
            });
        };

        window.closeSquadModal = () => document.getElementById('modal-squad').classList.add('hidden');

        window.saveSquadProfile = async () => {
            const roleInput = document.getElementById(`edit_role_${window.activeMember.id}`);
            const avatarInput = document.getElementById(`edit_avatar_${window.activeMember.id}`);
            if (roleInput) window.activeMember.role = roleInput.value.trim();
            if (avatarInput) window.activeMember.customAvatar = avatarInput.value.trim();

            const idx = window.squadMembers.findIndex(m => m.id === window.activeMember.id);
            if (idx !== -1) window.squadMembers[idx] = window.activeMember;

            await persistMemberToFirestore(window.activeMember);
            closeSquadModal();
            renderUI();
        };

        // ==================== INICIALIZAÇÃO FIREBASE (trioTMJ) ====================
        window.addEventListener('DOMContentLoaded', async () => {
            try {
                window.appId = typeof __app_id !== 'undefined' ? __app_id : window.PROJECT_ID;
                
                let firebaseConfig = null;
                if (window.TRIO_TMJ_FIREBASE_CONFIG && window.TRIO_TMJ_FIREBASE_CONFIG.apiKey.trim() !== "") {
                    firebaseConfig = window.TRIO_TMJ_FIREBASE_CONFIG;
                } else if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                    firebaseConfig = JSON.parse(__firebase_config);
                }

                if (firebaseConfig) {
                    const app = initializeApp(firebaseConfig);
                    const auth = getAuth(app);
                    window.db = getFirestore(app);

                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token && !window.TRIO_TMJ_FIREBASE_CONFIG.apiKey) {
                        await signInWithCustomToken(auth, __initial_auth_token);
                    } else {
                        await signInAnonymously(auth);
                    }

                    window.currentUser = auth.currentUser;
                    if (!window.currentUser) return;

                    window.isDbReady = true;

                    // Sincroniza membros
                    const membersColRef = collection(window.db, 'artifacts', window.appId, 'public', 'data', 'tmj_members');
                    onSnapshot(membersColRef, async (snap) => {
                        if (snap.empty) {
                            for (const m of window.squadMembers) {
                                await persistMemberToFirestore(m);
                            }
                        } else {
                            snap.docs.forEach(d => {
                                const data = d.data();
                                const idx = window.squadMembers.findIndex(m => m.id === data.id);
                                if (idx !== -1) {
                                    window.squadMembers[idx] = { ...window.squadMembers[idx], ...data };
                                }
                            });
                        }
                        if (!document.getElementById('login-screen').classList.contains('hidden')) {
                            window.renderLoginUsers();
                        }
                    });

                    // Sincroniza Vault
                    const vaultColRef = collection(window.db, 'artifacts', window.appId, 'public', 'data', 'tmj_vault');
                    onSnapshot(vaultColRef, (snap) => {
                        window.vaultItems = snap.docs.map(d => ({ ...d.data(), docId: d.id }));
                        if (!document.getElementById('app-shell').classList.contains('hidden')) {
                            renderVault();
                        }
                    });

                    // Sincroniza Chat
                    const chatColRef = collection(window.db, 'artifacts', window.appId, 'public', 'data', 'tmj_chat');
                    onSnapshot(chatColRef, (snap) => {
                        window.chatMessages = snap.docs.map(d => ({ ...d.data(), docId: d.id }));
                        if (!document.getElementById('app-shell').classList.contains('hidden')) {
                            renderChat();
                        }
                    });
                }
            } catch (err) {
                console.error("Modo local ativo:", err);
            }
        });
    </script>
</body>
</html>