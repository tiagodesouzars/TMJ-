        window.startChatAudioRecord = async () => {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                chatMediaRecorder = new MediaRecorder(stream);
                chatAudioChunks = [];
                chatMediaRecorder.ondataavailable = e => chatAudioChunks.push(e.data);
                chatMediaRecorder.onstop = () => {
                    recordedAudioBlob = new Blob(chatAudioChunks, { type: 'audio/webm' });
                    recordedAudioUrl = URL.createObjectURL(recordedAudioBlob);
                    document.getElementById('chat-recording-bar').classList.add('hidden');
                    document.getElementById('chat-preview-bar').classList.remove('hidden');
